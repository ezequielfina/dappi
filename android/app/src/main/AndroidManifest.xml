<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="TravelGuide"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Api">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCQi2ewYbxlK8D_ADcrH2TKiLBL6cyQei0" />

        <activity
            android:name="ar.edu.uade.api.ui.welcome.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Api">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="ar.edu.uade.api.ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.register.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.home.Explore"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.home.Home"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.map.MapActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.user.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.places.Place"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.places.Review"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <activity
            android:name="ar.edu.uade.api.ui.user.ProfileConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.Api" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ar.edu.uade.api.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>