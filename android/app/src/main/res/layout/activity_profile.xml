<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- App bar must be inside AppBarLayout for scroll flags to work -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="829dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".ui.ProfileActivity">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== HEADER ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="225dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/headerCard"
                    android:layout_width="match_parent"
                    android:layout_height="97dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="70dp"
                    android:layout_marginEnd="25dp"
                    app:cardBackgroundColor="@color/header_dark"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="true"
                    app:strokeWidth="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="255dp"
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="20dp">

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/topAppBar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:background="@drawable/bg_toolbar_grad"
                        app:layout_scrollFlags="scroll|enterAlways"
                        app:menu="@menu/menu_profile_top"
                        app:title="" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_avatar_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Ezequiel"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Métricas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            style="@style/StatPill"
                            android:layout_weight="1">

                            <TextView
                                style="@style/StatTitle"
                                android:text="RESEÑAS REALIZADAS" />

                            <TextView
                                style="@style/StatValue"
                                android:text="100" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/StatPill"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1">

                            <TextView
                                style="@style/StatTitle"
                                android:text="UP VOTES EN RESEÑAS" />

                            <TextView
                                style="@style/StatValue"
                                android:text="25000" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/StatPill"
                            android:layout_weight="1">

                            <TextView
                                style="@style/StatTitle"
                                android:text="CUENTA CREADA EL" />

                            <TextView
                                style="@style/StatValue"
                                android:text="20-01-2025" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- LUGARES FAVORITOS -->
            <TextView
                style="@style/SectionTitle"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:text="LUGARES FAVORITOS" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavorites"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_place_thumb" />

            <!-- RESEÑAS MÁS POPULARES -->
            <TextView
                style="@style/SectionTitle"
                android:layout_height="65dp"
                android:layout_marginTop="15dp"
                android:text="RESEÑAS MÁS POPULARES" />

            <include layout="@layout/item_review_highlight" />

            <!-- Sección: Países visitados -->

            <TextView
                style="@style/SectionTitle"
                android:layout_height="65dp"
                android:layout_marginTop="15dp"
                android:text="PAÍSES VISITADOS" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                >

                <ImageButton
                    android:id="@+id/btnFlagsScrollLeft"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/rvFlagsContainer"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Scroll Left"
                    android:src="@drawable/ic_chevron_left_24" />

                <FrameLayout
                    android:id="@+id/rvFlagsContainer"
                    android:layout_width="325dp"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFlags"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="15dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_flag" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnFlagsScrollRight"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/rvFlagsContainer"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Scroll Right"
                    android:src="@drawable/ic_chevron_right_24" />

            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation at the bottom of the CoordinatorLayout -->
<com.google.android.material.bottomnavigation.BottomNavigationView
android:id="@+id/bottomNav"
android:layout_width="match_parent"
android:layout_height="@dimen/bottom_nav_height"
android:layout_gravity="bottom"
android:paddingStart="16dp"
android:paddingEnd="16dp"
android:paddingTop="8dp"
android:paddingBottom="8dp"
android:background="@drawable/bg_bottom_nav"
app:menu="@menu/bottom_nav_menu"
    app:itemIconTint="@color/bottom_nav_icon_tint"
    app:itemTextColor="@color/bottom_nav_icon_tint"
app:labelVisibilityMode="unlabeled"
app:itemActiveIndicatorStyle="@style/BottomNav.ActiveIndicator"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
