<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="20dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#031f2b">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola, Ezequiel"
                android:textStyle="bold"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botón dark mode -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:padding="1dp"
            android:background="@drawable/toggle_background">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/white"
                android:padding="4dp"
                android:contentDescription="@string/dark_mode"
                android:src="@drawable/dark_mode"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Avatar -->
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/avatar_foreground"
            android:background="@drawable/circle_avatar"
            android:clipToOutline="true"
            tools:ignore="UnusedAttribute"
            android:contentDescription="Avatar" />

    </LinearLayout>

    <!-- Buscador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/search_bg"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="16dp"
        android:padding="16dp"
        android:layout_marginVertical="20dp">

        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints=""
            android:minHeight="48dp"
            android:importantForAccessibility="yes"
            android:hint="Buscar lugar"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColorHint="#B0B0B0"
            android:textSize="16sp"
            android:background="@null" />



        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_search_category_default"
            android:contentDescription="Buscar" />

    </LinearLayout>

    <!-- Categorías -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parques"
                android:textColor="#4A90E2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:background="@drawable/tab_selected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurantes"
                android:textColor="#B0B0B0"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Museos"
                android:textColor="#B0B0B0"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bares"
                android:textColor="#B0B0B0"
                android:textSize="16sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ScrollView para las cards de lugar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Mount Bromo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Imagen -->
                    <FrameLayout
                        android:id="@+id/place_card_mount"
                        android:layout_width="match_parent"
                        android:layout_height="180dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/parque_rivadavia_foreground"
                            android:contentDescription="Parque card 1" />

                        <!-- Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/gradient_overlay" />
                    </FrameLayout>

                    <!-- Información -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Nombre y rating -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mount Bromo"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.7 ⭐"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Ubicación -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Monserrat, Ciudad Buenos A... • +500 reseñas"
                            android:textColor="#B0B0B0"
                            android:textSize="14sp" />

                        <!-- Lugar y distancia -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="20sp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📍 5 km de tu ubicación"
                                android:textColor="#B0B0B0"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Abierto"
                                android:textColor="#4CAF50"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Reseña -->
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:background="@drawable/search_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <TextView
                                    android:text="Matias, Rodriguez"
                                    android:textColor="#ffffff"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                </TextView>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:textColor="#ffffff"
                                    android:text="3.0 ⭐"
                                    android:textAlignment="textEnd"
                                    android:layout_height="match_parent">
                                </TextView>
                            </LinearLayout>

                            <!-- Descripción -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:text="Visita al Mount Bromo al fin de semana y más encanto esperaría."
                                android:textColor="#B0B0B0"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:gravity="start"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/exp_arrow_upward"
                                    android:contentDescription="arrow_upward"
                                    android:background="@drawable/circle_bg"
                                    app:tint="#FFFFFF" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:textColor="#ffffff"
                                    android:layout_marginHorizontal="10dp"
                                    android:gravity="center"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:text="25"
                                    android:layout_height="match_parent" />
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/exp_arrow_downward"
                                    android:contentDescription="arrow_downward"
                                    android:background="@drawable/circle_bg"
                                    app:tint="#FFFFFF" />
                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 2: Parque Las heras -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Imagen -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Parque card 2"
                            android:src="@mipmap/parque_centenario_foreground" />

                        <!-- Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/gradient_overlay" />
                    </FrameLayout>

                    <!-- Información -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Nombre y rating -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Parque Las heras"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3.7 ⭐"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Ubicación -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Palermo, Ciudad Buenos A..."
                            android:textColor="#B0B0B0"
                            android:textSize="14sp" />

                        <!-- Estado -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Abierto"
                            android:textColor="#4CAF50"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Reseña -->
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:background="@drawable/search_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <TextView
                                    android:text="Joaco, Rodriguez"
                                    android:textColor="#ffffff"
                                    android:textStyle="bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                </TextView>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:textColor="#ffffff"
                                    android:text="4.0 ⭐"
                                    android:textAlignment="textEnd"
                                    android:layout_height="match_parent">
                                </TextView>
                            </LinearLayout>

                            <!-- Descripción -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:text="Hermoso, es un parque hermoso. Buena iluminación durante la noche."
                                android:textColor="#B0B0B0"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:gravity="start"
                                android:layout_height="match_parent">
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/exp_arrow_upward"
                                    android:contentDescription="arrow_upward"
                                    android:background="@drawable/circle_bg"
                                    app:tint="#FFFFFF" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:textColor="#ffffff"
                                    android:layout_marginHorizontal="10dp"
                                    android:gravity="center"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:text="38"
                                    android:layout_height="match_parent" />
                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/exp_arrow_downward"
                                    android:contentDescription="arrow_downward"
                                    android:background="@drawable/circle_bg"
                                    app:tint="#FFFFFF" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@drawable/nav_rouded"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Inicio"
                app:tint="#5edfff" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/explore"
                android:contentDescription="Ayuda"
                app:tint="@color/white"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/account_nav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/account"
                app:tint="@color/white"
                android:contentDescription="Perfil" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>