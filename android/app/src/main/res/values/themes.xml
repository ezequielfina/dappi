<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Api" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores personalizados para TravelGuide -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/light_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/background_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">#FFB326</item>
        <item name="colorOnError">@color/text_primary</item>
        
        <!-- Deshabilitar colores automáticos de Material Design -->
        <item name="colorPrimaryDark">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>

    <style name="Theme.Api" parent="Base.Theme.Api" />

    <!-- Tema alternativo de TravelGuide -->
    <style name="Base.Theme.Travelguide" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Se puede usar para variaciones futuras del tema -->
    </style>

    <style name="Theme.Travelguide" parent="Base.Theme.Travelguide" />

    <!-- Custom RatingBar style -->
    <style name="RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="colorControlNormal">@color/white</item> <!-- Color for unselected stars -->
        <item name="colorControlActivated">@color/starOrange</item> <!-- Color for selected stars -->
    </style>

    <!-- Bottom Navigation Active Indicator -->
    <style name="BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:drawable">@drawable/bottom_nav_active_indicator_bg</item>
    </style>
</resources>